# ===========================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# ===========================================
# Copy this to .env.local and customize

# Backend API URL (default: local development)
VITE_API_URL=http://localhost:8000/api/v1

# Dev Mode: Match Speed Multiplier
# Set to speed up match time for testing (1 = normal, 10 = 10x speed)
# At 10x: 3 real minutes = 30 match minutes
# At 20x: 1.5 real minutes = 30 match minutes
# Remove or set to 1 for normal speed
VITE_DEV_MATCH_SPEED=10
