# ===========================================
# PRODUCTION ENVIRONMENT VARIABLES - BACKEND
# ===========================================
# Copy this to Railway's environment variables

# Database (Railway provides this automatically when you add PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/railway

# Environment
ENVIRONMENT=production

# Anthropic AI
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=dungloe-gaa-data
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# CORS - Frontend URL (update after Vercel deployment)
FRONTEND_URL=https://dungloe-gaa.vercel.app

# Optional: Sentry for error tracking
# SENTRY_DSN=https://xxx@sentry.io/xxx
